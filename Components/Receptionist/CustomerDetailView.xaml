<UserControl x:Class="Animal_Spa.Components.Receptionist.CustomerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource Baloo2}">

    <UserControl.Resources>
        <Style x:Key="SmallActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#F2F7FB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1770" Height="900" Background="Transparent">
            <Canvas>

                <TextBlock Canvas.Left="70"
                           Canvas.Top="20"
                           Text="CUSTOMER PROFILE"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#6C6C6C"/>

                <Border Canvas.Left="70"
                        Canvas.Top="70"
                        Width="790"
                        Height="285"
                        Background="#88BBE5"
                        CornerRadius="34">

                    <Grid Margin="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="190"
                                Height="190"
                                CornerRadius="95"
                                Background="#FFFFFF"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ClipToBounds="True">
                            <Image Source="/Animal-Spa;component/Asset/ICON-COSTUMER.png"
                                   Stretch="UniformToFill"/>
                        </Border>

                        <Grid Grid.Column="1" Margin="18,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Content="Edit"
                                    Width="82"
                                    Height="45"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    FontSize="25"
                                    Padding="8,0"
                                    Style="{StaticResource SmallActionButtonStyle}"
                                    Click="EditCustomer_Click"/>

                            <TextBlock x:Name="CustomerNameText"
                                       Grid.Row="0"
                                       Text="KHA BÙI"
                                       FontSize="52"
                                       FontWeight="ExtraBold"
                                       Foreground="#101010"
                                       Margin="0,14,100,0"/>

                            <TextBlock x:Name="CustomerPhoneText"
                                       Grid.Row="1"
                                       Text="+84xxxxxx647"
                                       FontSize="31"
                                       Foreground="#111111"
                                       Margin="0,0,0,10"/>

                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom">

                                <ItemsControl x:Name="CustomerPetIconsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="62"
                                                    Height="62"
                                                    Margin="0,0,10,0"
                                                    Background="#F8FBFD"
                                                    CornerRadius="12">
                                                <Image Source="{Binding AnimalIcon}"
                                                       Margin="6"
                                                       Stretch="Uniform"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Width="62"
                                        Height="62"
                                        Background="#D8DDE1"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="48"
                                        FontWeight="Bold"
                                        Content="+"
                                        Cursor="Hand"
                                        Click="AddPet_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="AddPetBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,-7,0,0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="AddPetBorder" Property="Background" Value="#C8D0D6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Canvas.Left="930"
                        Canvas.Top="70"
                        Width="770"
                        Height="76"
                        Background="#88BBE5"
                        CornerRadius="30">
                    <TextBlock x:Name="AddressText"
                               Text="......."
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="#202020"
                               VerticalAlignment="Center"
                               Margin="25,0"/>
                </Border>

                <Border Canvas.Left="930"
                        Canvas.Top="180"
                        Width="770"
                        Height="175"
                        Background="#88BBE5"
                        CornerRadius="30">
                    <TextBlock x:Name="NoteText"
                               Text="YÊU CẦU CAO VỀ VỆ SINH LÔNG"
                               FontSize="26"
                               Foreground="#202020"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               Margin="25,22"/>
                </Border>

                <ScrollViewer Canvas.Left="70"
                              Canvas.Top="420"
                              Width="1630"
                              Height="410"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly">

                    <StackPanel Orientation="Horizontal">
                        <ItemsControl x:Name="PetItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="300"
                                            Height="365"
                                            Margin="0,0,34,0"
                                            Padding="18"
                                            Background="#A9CBE8"
                                            CornerRadius="30">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="45"/>
                                                <RowDefinition Height="52"/>
                                                <RowDefinition Height="180"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Height="34"
                                                        Margin="0,0,8,0"
                                                        Background="#F7F7F7"
                                                        CornerRadius="12">
                                                    <TextBlock Text="{Binding DateOfBirth}"
                                                               FontSize="17"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <Border Grid.Column="1"
                                                        Height="34"
                                                        Margin="8,0,0,0"
                                                        Background="#F7F7F7"
                                                        CornerRadius="12">
                                                    <TextBlock Text="{Binding Breed}"
                                                               FontSize="17"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </Grid>

                                            <Border Grid.Row="1"
                                                    Height="42"
                                                    Background="#D98CE8"
                                                    CornerRadius="10">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="29"
                                                           FontWeight="ExtraBold"
                                                           Foreground="#111111"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <Border Grid.Row="2"
                                                    Width="150"
                                                    Height="150"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="#D8D8D8"
                                                    CornerRadius="14">
                                                <TextBlock Text="PHOTO"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="#A0A0A0"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Row="3"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Image Source="{Binding AnimalIcon}"
                                                       Width="52"
                                                       Height="52"
                                                       Stretch="Uniform"/>
                                                <TextBlock Text="{Binding Type}"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"
                                                           Foreground="#333333"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Width="300"
                                Height="365"
                                Margin="0,0,20,0"
                                Background="#D9D9D9"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="AddPet_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="AddCardBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="30">
                                        <TextBlock Text="+"
                                                   FontSize="130"
                                                   FontWeight="Light"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,-15,0,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="AddCardBorder" Property="Background" Value="#CBCBCB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
