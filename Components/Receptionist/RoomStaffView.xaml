<UserControl x:Class="Animal_Spa.Components.Receptionist.RoomStaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1400"
             d:DesignHeight="760"
             FontFamily="{StaticResource Baloo2}"
             Background="White">

    <UserControl.Resources>
        <Style x:Key="ChoiceCardStyle" TargetType="Button">
            <Setter Property="Height" Value="130"/>
            <Setter Property="Background" Value="#FDFDFD"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChoiceBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="24">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="#F3F9FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoomStaffButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="62"/>
            <Setter Property="MinWidth" Value="230"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1770" Height="1100">
            <Border Width="1630"
                    Height="1020"
                    Background="#EEF6FC"
                    BorderBrush="#A8C9E8"
                    BorderThickness="2"
                    CornerRadius="38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="105"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#A8C9E8"
                            CornerRadius="38,38,0,0">
                        <Grid Margin="34,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="230"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="/Animal-Spa;component/Asset/ICON-PET.png"
                                   Width="82"
                                   Height="82"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="ROOM &amp; STAFF"
                                           FontSize="40"
                                           FontWeight="ExtraBold"
                                           Foreground="#111111"/>
                                <TextBlock Text="Select available room and working staff"
                                           FontSize="22"
                                           Foreground="#202020"
                                           Margin="0,-4,0,0"/>
                            </StackPanel>

                            <Grid Grid.Column="2"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Margin="0,16,6,0">
                                <Ellipse Width="28" Height="28" Fill="#4A8DD8" HorizontalAlignment="Right" Margin="0,0,48,0"/>
                                <Ellipse Width="18" Height="18" Fill="#4A8DD8" HorizontalAlignment="Right" Margin="0,34,12,0"/>
                                <Ellipse Width="14" Height="14" Fill="#4A8DD8" HorizontalAlignment="Right" Margin="0,6,2,0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="44,28,44,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="90"/>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="140"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="AVAILABLE ROOM"
                                           FontSize="31"
                                           FontWeight="ExtraBold"/>
                                <TextBlock Text="Choose a room for this booking"
                                           FontSize="21"
                                           Foreground="#333333"
                                           Margin="0,-3,0,0"/>
                            </StackPanel>

                            <Button x:Name="Room1Button"
                                    Grid.Row="1"
                                    Tag="ROOM 1"
                                    Style="{StaticResource ChoiceCardStyle}"
                                    Click="Room_Click"
                                    Margin="0,5,0,5">
                                <Grid Margin="18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="86"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="76" Height="76" Background="#A8C9E8" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="ROOM 1" FontSize="28" FontWeight="ExtraBold"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="18" Height="18" Fill="#18D849" Margin="0,2,8,0"/>
                                            <TextBlock Text="Available" FontSize="20"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Grid.Column="2" Width="62" Height="62" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse x:Name="Room1Outer" Fill="White" Stroke="#3E84D8" StrokeThickness="5"/>
                                        <Ellipse x:Name="Room1Inner" Width="31" Height="31" Fill="#A8C9E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Button>

                            <Button x:Name="Room2Button"
                                    Grid.Row="2"
                                    Tag="ROOM 2"
                                    Style="{StaticResource ChoiceCardStyle}"
                                    Click="Room_Click"
                                    Margin="0,5,0,5">
                                <Grid Margin="18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="86"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="76" Height="76" Background="#A8C9E8" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="ROOM 2" FontSize="28" FontWeight="ExtraBold"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="18" Height="18" Fill="#18D849" Margin="0,2,8,0"/>
                                            <TextBlock Text="Available" FontSize="20"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Column="2" Width="62" Height="62" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse x:Name="Room2Outer" Fill="White" Stroke="#111111" StrokeThickness="5"/>
                                        <Ellipse x:Name="Room2Inner" Width="31" Height="31" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Button>

                            <Button x:Name="Room3Button"
                                    Grid.Row="3"
                                    Tag="ROOM 3"
                                    Style="{StaticResource ChoiceCardStyle}"
                                    Click="Room_Click"
                                    Margin="0,5,0,5">
                                <Grid Margin="18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="86"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="76" Height="76" Background="#A8C9E8" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="ROOM 3" FontSize="28" FontWeight="ExtraBold"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="18" Height="18" Fill="#18D849" Margin="0,2,8,0"/>
                                            <TextBlock Text="Available" FontSize="20"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Column="2" Width="62" Height="62" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse x:Name="Room3Outer" Fill="White" Stroke="#111111" StrokeThickness="5"/>
                                        <Ellipse x:Name="Room3Inner" Width="31" Height="31" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Button>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="90"/>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="140"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="WORKING STAFF"
                                           FontSize="31"
                                           FontWeight="ExtraBold"/>
                                <TextBlock Text="Choose a staff for this booking"
                                           FontSize="21"
                                           Foreground="#333333"
                                           Margin="0,-3,0,0"/>
                            </StackPanel>

                            <Button x:Name="StaffAButton"
                                    Grid.Row="1"
                                    Tag="Nguyen Van A"
                                    Style="{StaticResource ChoiceCardStyle}"
                                    Click="Staff_Click"
                                    Margin="0,5,0,5">
                                <Grid Margin="18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="86"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="76" Height="76" Background="#A8C9E8" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Nguyen Van A" FontSize="28" FontWeight="ExtraBold"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="18" Height="18" Fill="#18D849" Margin="0,2,8,0"/>
                                            <TextBlock Text="Available" FontSize="20"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Column="2" Width="62" Height="62" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse x:Name="StaffAOuter" Fill="White" Stroke="#111111" StrokeThickness="5"/>
                                        <Ellipse x:Name="StaffAInner" Width="31" Height="31" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Button>

                            <Button x:Name="StaffBButton"
                                    Grid.Row="2"
                                    Tag="Nguyen Van B"
                                    Style="{StaticResource ChoiceCardStyle}"
                                    Click="Staff_Click"
                                    Margin="0,5,0,5">
                                <Grid Margin="18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="86"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="76" Height="76" Background="#A8C9E8" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Nguyen Van B" FontSize="28" FontWeight="ExtraBold"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="18" Height="18" Fill="#18D849" Margin="0,2,8,0"/>
                                            <TextBlock Text="Available" FontSize="20"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Column="2" Width="62" Height="62" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse x:Name="StaffBOuter" Fill="White" Stroke="#3E84D8" StrokeThickness="5"/>
                                        <Ellipse x:Name="StaffBInner" Width="31" Height="31" Fill="#A8C9E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Button>

                            <Button x:Name="StaffCButton"
                                    Grid.Row="3"
                                    Tag="Nguyen Van C"
                                    Style="{StaticResource ChoiceCardStyle}"
                                    Click="Staff_Click"
                                    Margin="0,5,0,5">
                                <Grid Margin="18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="86"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="76" Height="76" Background="#A8C9E8" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Nguyen Van C" FontSize="28" FontWeight="ExtraBold"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="18" Height="18" Fill="#18D849" Margin="0,2,8,0"/>
                                            <TextBlock Text="Available" FontSize="20"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Column="2" Width="62" Height="62" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse x:Name="StaffCOuter" Fill="White" Stroke="#111111" StrokeThickness="5"/>
                                        <Ellipse x:Name="StaffCInner" Width="31" Height="31" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Button>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="44,0,44,0"
                            Background="White"
                            BorderBrush="#F6FBFE"
                            BorderThickness="5"
                            CornerRadius="25">
                        <Grid Margin="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ROOM : " FontSize="28" FontWeight="ExtraBold"/>
                                <TextBlock x:Name="SelectedRoomText" Text="1" FontSize="28" FontWeight="ExtraBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="STAFF : " FontSize="28" FontWeight="ExtraBold"/>
                                <TextBlock x:Name="SelectedStaffText" Text="Nguyen Van B" FontSize="28" FontWeight="ExtraBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,44,0">
                        <Button Content="Cancel"
                                Background="#D2D5D8"
                                Style="{StaticResource RoomStaffButtonStyle}"
                                Margin="0,0,20,0"
                                Click="Cancel_Click"/>
                        <Button Content="Confirm"
                                Background="#4EA6E8"
                                Style="{StaticResource RoomStaffButtonStyle}"
                                Click="Confirm_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
