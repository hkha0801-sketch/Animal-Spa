<UserControl x:Class="Animal_Spa.Components.Receptionist.ServiceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Baloo2}"
             Background="White">

    <UserControl.Resources>
        <Style x:Key="InfoRowStyle" TargetType="Border">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Background" Value="#A8C9E8"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="PriceCellStyle" TargetType="Button">
            <Setter Property="Background" Value="#A8C9E8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Foreground" Value="#151515"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CellBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CellBorder" Property="Background" Value="#8DBDE2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="210"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1770" Height="810" Background="White">
            <Border Width="1770"
                    Height="780"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#A8C9E8"
                    CornerRadius="34">

                <Grid Margin="28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="105"/>
                        <RowDefinition Height="550"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1190"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="/Animal-Spa;component/Asset/ICON-PET.png"
                               Width="82"
                               Height="82"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="SERVICE DETAIL"
                                       FontSize="40"
                                       FontWeight="ExtraBold"
                                       Foreground="#111111"/>
                            <TextBlock Text="Choose a service and view details of the service"
                                       FontSize="22"
                                       Foreground="#222222"
                                       Margin="0,-4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="0"
                            Grid.Column="2"
                            Background="White"
                            CornerRadius="28"
                            Padding="18,8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PRICING MATRIX"
                                       FontSize="34"
                                       FontWeight="ExtraBold"
                                       Foreground="#111111"/>
                            <TextBlock Text="Price varies by animal type and weight"
                                       FontSize="18"
                                       Foreground="#333333"
                                       Margin="0,-3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Background="White"
                            CornerRadius="28"
                            Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="320"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="380"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="#A8C9E8"
                                        CornerRadius="26"
                                        ClipToBounds="True">
                                    <Image Source="/Animal-Spa;component/Asset/ICON-BATH.jpg"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="78"/>
                                        <RowDefinition Height="70"/>
                                        <RowDefinition Height="70"/>
                                        <RowDefinition Height="70"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="ServiceNameText"
                                               Grid.Row="0"
                                               Text="Bath &amp; Dry"
                                               FontSize="38"
                                               FontWeight="ExtraBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#111111"/>

                                    <Border Grid.Row="1" Style="{StaticResource InfoRowStyle}">
                                        <Grid Margin="14,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Source="/Animal-Spa;component/Asset/ICON-PET.png"
                                                   Width="38"
                                                   Height="38"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                            <Image x:Name="SelectedAnimalIcon"
                                                   Grid.Column="1"
                                                   Width="48"
                                                   Height="48"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                            <Border Grid.Column="2"
                                                    Background="#BCD6EE"
                                                    CornerRadius="22"
                                                    Padding="18,4"
                                                    HorizontalAlignment="Right"
                                                    MinWidth="210">
                                                <TextBlock x:Name="WeightText"
                                                           Text="Choose from table"
                                                           FontSize="23"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2" Style="{StaticResource InfoRowStyle}">
                                        <Grid Margin="14,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Source="/Animal-Spa;component/Asset/ICON-PRICE.jpg"
                                                   Width="38"
                                                   Height="38"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="Price"
                                                       FontSize="25"
                                                       VerticalAlignment="Center"
                                                       Foreground="#111111"/>

                                            <TextBlock x:Name="PriceText"
                                                       Grid.Column="2"
                                                       Text="Choose from table"
                                                       FontSize="24"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Foreground="White"
                                                       Margin="0,0,18,0"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="3" Style="{StaticResource InfoRowStyle}" Margin="0">
                                        <Grid Margin="14,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Source="/Animal-Spa;component/Asset/ICON-TIME.jpg"
                                                   Width="38"
                                                   Height="38"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="Duration"
                                                       FontSize="25"
                                                       VerticalAlignment="Center"
                                                       Foreground="#111111"/>

                                            <TextBlock x:Name="DurationText"
                                                       Grid.Column="2"
                                                       Text="60 mins"
                                                       FontSize="24"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Foreground="White"
                                                       Margin="0,0,18,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="#A8C9E8"
                                    CornerRadius="24"
                                    Margin="0,14,0,0"
                                    Padding="24,18">
                                <StackPanel>
                                    <TextBlock Text="Service description"
                                               FontSize="29"
                                               Foreground="#111111"/>
                                    <TextBlock x:Name="DescriptionText"
                                               Text="Service description"
                                               FontSize="22"
                                               Foreground="#222222"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="2"
                            Background="White"
                            CornerRadius="28"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="72"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#A8C9E8" CornerRadius="8" Margin="4">
                                    <Image Source="/Animal-Spa;component/Asset/ICON-PET.png"
                                           Width="46"
                                           Height="46"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="1" Background="#A8C9E8" CornerRadius="8" Margin="4">
                                    <TextBlock Text="Under 10kg"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="2" Background="#A8C9E8" CornerRadius="8" Margin="4">
                                    <TextBlock Text="Over 10kg"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Background="#EEF5FA" Margin="4" CornerRadius="8">
                                    <Image Source="/Animal-Spa;component/Asset/animal/DOG.png"
                                           Width="64"
                                           Height="64"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>
                                <Button x:Name="DogUnderButton"
                                        Grid.Row="0" Grid.Column="1"
                                        Style="{StaticResource PriceCellStyle}"
                                        Tag="Dog|Under 10kg"
                                        Click="PriceCell_Click">
                                    <TextBlock x:Name="DogUnderPrice" Text="120.000đ"/>
                                </Button>
                                <Button x:Name="DogOverButton"
                                        Grid.Row="0" Grid.Column="2"
                                        Style="{StaticResource PriceCellStyle}"
                                        Tag="Dog|Over 10kg"
                                        Click="PriceCell_Click">
                                    <TextBlock x:Name="DogOverPrice" Text="180.000đ"/>
                                </Button>

                                <Border Grid.Row="1" Grid.Column="0" Background="#EEF5FA" Margin="4" CornerRadius="8">
                                    <Image Source="/Animal-Spa;component/Asset/animal/CAT.png"
                                           Width="64"
                                           Height="64"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>
                                <Button x:Name="CatUnderButton"
                                        Grid.Row="1" Grid.Column="1"
                                        Style="{StaticResource PriceCellStyle}"
                                        Tag="Cat|Under 10kg"
                                        Click="PriceCell_Click">
                                    <TextBlock x:Name="CatUnderPrice" Text="100.000đ"/>
                                </Button>
                                <Button x:Name="CatOverButton"
                                        Grid.Row="1" Grid.Column="2"
                                        Style="{StaticResource PriceCellStyle}"
                                        Tag="Cat|Over 10kg"
                                        Click="PriceCell_Click">
                                    <TextBlock x:Name="CatOverPrice" Text="150.000đ"/>
                                </Button>

                                <Border Grid.Row="2" Grid.Column="0" Background="#EEF5FA" Margin="4" CornerRadius="8">
                                    <Image Source="/Animal-Spa;component/Asset/animal/HAMSTER.png"
                                           Width="64"
                                           Height="64"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>
                                <Button x:Name="HamsterUnderButton"
                                        Grid.Row="2" Grid.Column="1"
                                        Style="{StaticResource PriceCellStyle}"
                                        Tag="Hamster|Under 10kg"
                                        Click="PriceCell_Click">
                                    <TextBlock x:Name="HamsterUnderPrice" Text="70.000đ"/>
                                </Button>
                                <Button x:Name="HamsterOverButton"
                                        Grid.Row="2" Grid.Column="2"
                                        Style="{StaticResource PriceCellStyle}"
                                        Tag="Hamster|Over 10kg"
                                        Click="PriceCell_Click">
                                    <TextBlock x:Name="HamsterOverPrice" Text="120.000đ"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Cancel"
                                Background="#D6D6D6"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,28,0"
                                Click="Cancel_Click"/>
                        <Button Content="Save"
                                Background="#4EA6E8"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
