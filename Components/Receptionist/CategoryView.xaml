<UserControl x:Class="Animal_Spa.Components.Receptionist.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource Baloo2}">

    <UserControl.Resources>
        <Style x:Key="CategoryCardButton" TargetType="Button">
            <Setter Property="Width" Value="330"/>
            <Setter Property="Height" Value="410"/>
            <Setter Property="Background" Value="#A9CBE9"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="30">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddCategoryButton" TargetType="Button">
            <Setter Property="Width" Value="330"/>
            <Setter Property="Height" Value="410"/>
            <Setter Property="Background" Value="#D5D5D5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AddBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="30">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AddBorder" Property="Background" Value="#C9C9C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid Width="1770" Height="680" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="175"/>
                <RowDefinition Height="450"/>
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Width="1650"
                  Height="145"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Border CornerRadius="30" ClipToBounds="True">
                    <Image Source="/Animal-Spa;component/Asset/BACKGROUND-CATEGORY.jpg"
                           Stretch="Fill"/>
                </Border>

                <Grid Margin="45,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="/Animal-Spa;component/Asset/ICON-PET.png"
                           Width="105"
                           Height="85"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="5,0,0,0">
                        <TextBlock Text="CATEGORY"
                                   FontSize="44"
                                   FontWeight="ExtraBold"
                                   Foreground="#111111"/>
                        <TextBlock Text="Choose a service category for your pet"
                                   FontSize="23"
                                   FontWeight="Medium"
                                   Foreground="#202020"
                                   Margin="0,-5,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="1"
                  Width="1650"
                  HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BathCategoryButton"
                        Grid.Column="0"
                        Style="{StaticResource CategoryCardButton}"
                        Tag="Bath &amp; Dry"
                        Click="Category_Click">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="75"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Height="58"
                                Margin="0,5,0,0"
                                Background="#82BCE5"
                                CornerRadius="24">
                            <TextBlock Text="Bath &amp; Dry"
                                       FontSize="32"
                                       FontWeight="ExtraBold"
                                       Foreground="#111111"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Image Grid.Row="1"
                               Source="/Animal-Spa;component/Asset/ICON-PET.png"
                               Width="45"
                               Height="38"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"/>

                        <Border Grid.Row="2"
                                Background="White"
                                CornerRadius="24"
                                Margin="5,0,5,5"
                                ClipToBounds="True">
                            <Image Source="/Animal-Spa;component/Asset/ICON-BATH.jpg"
                                   Stretch="Uniform"/>
                        </Border>
                    </Grid>
                </Button>

                <Button x:Name="HairCategoryButton"
                        Grid.Column="2"
                        Style="{StaticResource CategoryCardButton}"
                        Tag="Hair Trimming"
                        Click="Category_Click">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="75"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Height="58"
                                Margin="0,5,0,0"
                                Background="#82BCE5"
                                CornerRadius="24">
                            <TextBlock Text="Hair Trimming"
                                       FontSize="30"
                                       FontWeight="ExtraBold"
                                       Foreground="#111111"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Image Grid.Row="1"
                               Source="/Animal-Spa;component/Asset/ICON-PET.png"
                               Width="45"
                               Height="38"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"/>

                        <Border Grid.Row="2"
                                Background="White"
                                CornerRadius="24"
                                Margin="5,0,5,5"
                                ClipToBounds="True">
                            <Image Source="/Animal-Spa;component/Asset/ICON-BATH.jpg"
                                   Stretch="Uniform"/>
                        </Border>
                    </Grid>
                </Button>

                <Button x:Name="EarCategoryButton"
                        Grid.Column="4"
                        Style="{StaticResource CategoryCardButton}"
                        Tag="Ear Cleaning"
                        Click="Category_Click">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="75"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Height="58"
                                Margin="0,5,0,0"
                                Background="#82BCE5"
                                CornerRadius="24">
                            <TextBlock Text="Ear Cleaning"
                                       FontSize="30"
                                       FontWeight="ExtraBold"
                                       Foreground="#111111"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Image Grid.Row="1"
                               Source="/Animal-Spa;component/Asset/ICON-PET.png"
                               Width="45"
                               Height="38"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"/>

                        <Border Grid.Row="2"
                                Background="White"
                                CornerRadius="24"
                                Margin="5,0,5,5"
                                ClipToBounds="True">
                            <Image Source="/Animal-Spa;component/Asset/ICON-BATH.jpg"
                                   Stretch="Uniform"/>
                        </Border>
                    </Grid>
                </Button>

                <Button x:Name="AddCategoryButton"
                        Grid.Column="6"
                        Style="{StaticResource AddCategoryButton}"
                        Tag="AddCategory">
                    <Grid>
                        <Rectangle Width="110"
                                   Height="28"
                                   RadiusX="14"
                                   RadiusY="14"
                                   Fill="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Rectangle Width="28"
                                   Height="110"
                                   RadiusX="14"
                                   RadiusY="14"
                                   Fill="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Button x:Name="NailCategoryButton"
                        Grid.Column="6"
                        Style="{StaticResource CategoryCardButton}"
                        Tag="Nail Care"
                        Click="Category_Click"
                        Visibility="Collapsed">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="75"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Height="58"
                                Margin="0,5,0,0"
                                Background="#82BCE5"
                                CornerRadius="24">
                            <TextBlock Text="Nail Care"
                                       FontSize="30"
                                       FontWeight="ExtraBold"
                                       Foreground="#111111"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Image Grid.Row="1"
                               Source="/Animal-Spa;component/Asset/ICON-PET.png"
                               Width="45"
                               Height="38"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"/>

                        <Border Grid.Row="2"
                                Background="White"
                                CornerRadius="24"
                                Margin="5,0,5,5"
                                ClipToBounds="True">
                            <Image Source="/Animal-Spa;component/Asset/ICON-BATH.jpg"
                                   Stretch="Uniform"/>
                        </Border>
                    </Grid>
                </Button>
            </Grid>

            <Border Grid.Row="2"
                    Width="330"
                    Height="26"
                    Background="#83BCE5"
                    CornerRadius="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
        </Grid>
    </Viewbox>
</UserControl>
