<UserControl x:Class="Animal_Spa.Components.Receptionist.AddCustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:shared="clr-namespace:Animal_Spa.Components.Shared"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource Baloo2}">

    <UserControl.Resources>
      <ResourceDictionary>
       <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Animal-Spa;component/Components/Shared/ComponentStyles.xaml"/>
       </ResourceDictionary.MergedDictionaries>



          </ResourceDictionary>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1770" Height="840" Background="Transparent">
            <Canvas>

                <TextBlock Canvas.Left="70"
                           Canvas.Top="18"
                           Text="ADD CUSTOMER"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#6C6C6C"/>

                <Border Canvas.Left="70"
                        Canvas.Top="70"
                        Width="1630"
                        Height="700"
                        Background="#AACBE8"
                        CornerRadius="28">

                    <Canvas>

                        <shared:PhotoUpload x:Name="PhotoPicker"
                              Canvas.Left="45"
                              Canvas.Top="42"
                              Width="562"
                              Height="541"
                              Cursor="Hand"
                              ToolTip="Click to choose a customer photo"
                              Subject="customer" PhotoFill="#F5F5F5" BorderBrush="#8EBBDD"
                              StatusChanged="PhotoPicker_StatusChanged">
                         <shared:PhotoUpload.FallbackContent>
                           <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <TextBlock Text="&#xE8B9;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="78"
                                           Foreground="#8AA7B8"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Upload Your Photo"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#8AA7B8"
                                           HorizontalAlignment="Center"
                                           Margin="0,14,0,0"/>
                                <TextBlock Text="Click here to choose an image"
                                           FontSize="18"
                                           Foreground="#A5B6C1"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                         </shared:PhotoUpload.FallbackContent>
                        </shared:PhotoUpload>

                        <Button Canvas.Left="45"
                                Canvas.Top="610"
                                Width="210"
                                Content="Cancel"
                                Background="#D9D9D9"
                                Foreground="#FFFFFF"
                                Style="{StaticResource AddCustomerActionButtonStyle}"
                                Click="Cancel_Click"/>

                        <Button Canvas.Left="285"
                                Canvas.Top="610"
                                Width="210"
                                Content="Save"
                                Background="#4EA6E8"
                                Style="{StaticResource AddCustomerActionButtonStyle}"
                                Click="Save_Click"/>

                        <Grid Canvas.Left="670"
                              Canvas.Top="45"
                              Width="900"
                              Height="595">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="130"/>
                                <RowDefinition Height="125"/>
                                <RowDefinition Height="125"/>
                                <RowDefinition Height="215"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="520"/>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="345"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Customer Name"
                                               Style="{StaticResource AddCustomerFieldLabelStyle}"/>
                                    <Border Height="66"
                                            Background="#F7F7F7"
                                            CornerRadius="13">
                                        <TextBox x:Name="CustomerNameTextBox"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="18,0"
                                                 FontSize="22"
                                                 VerticalContentAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Gender"
                                               Style="{StaticResource AddCustomerFieldLabelStyle}"/>
                                    <Border Height="66"
                                            Background="#F7F7F7"
                                            CornerRadius="13">
                                        <ComboBox x:Name="GenderComboBox"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="13,0"
                                                  FontSize="21"
                                                  VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="Male"/>
                                            <ComboBoxItem Content="Female"/>
                                            <ComboBoxItem Content="Other"/>
                                        </ComboBox>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Phone Number"
                                           Style="{StaticResource AddCustomerFieldLabelStyle}"/>
                                <Border Height="66"
                                        Background="#F7F7F7"
                                        CornerRadius="13">
                                    <TextBox x:Name="PhoneNumberTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="18,0"
                                             FontSize="22"
                                             VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Address"
                                           Style="{StaticResource AddCustomerFieldLabelStyle}"/>
                                <Border Height="66"
                                        Background="#F7F7F7"
                                        CornerRadius="13">
                                    <TextBox x:Name="AddressTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="18,0"
                                             FontSize="22"
                                             VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="3">
                                <TextBlock Text="Note"
                                           Style="{StaticResource AddCustomerFieldLabelStyle}"/>
                                <Border Height="150"
                                        Background="#F7F7F7"
                                        CornerRadius="13">
                                    <TextBox x:Name="NoteTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="18,14"
                                             FontSize="22"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="StatusText"
                                   Canvas.Left="670"
                                   Canvas.Top="655"
                                   Width="900"
                                   FontSize="20"
                                   Foreground="#2F6A91"
                                   TextAlignment="Right"/>
                    </Canvas>
                </Border>
            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
