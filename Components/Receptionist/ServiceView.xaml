<UserControl x:Class="Animal_Spa.Components.Receptionist.ServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Baloo2}">

    <UserControl.Resources>

        <Style x:Key="ServiceCardStyle"
               TargetType="Button">

            <Setter Property="Width" Value="510"/>
            <Setter Property="Height" Value="330"/>
            <Setter Property="Background" Value="#83B8DE"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="28">

                            <ContentPresenter/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <Viewbox Stretch="Uniform">

        <Grid Width="1770"
              Height="620">

            <Border Width="1650"
                    Height="550"
                    Background="#A8C9E8"
                    CornerRadius="35"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Grid Margin="35">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="130"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="620"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="620"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="580"
                                Height="105"
                                HorizontalAlignment="Left"
                                Background="#83B8DE"
                                CornerRadius="28">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="/Animal-Spa;component/Asset/ICON-PET.png"
                                       Width="78"
                                       Height="78"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="SERVICE LIST"
                                               FontSize="38"
                                               FontWeight="ExtraBold"
                                               Foreground="#111111"/>

                                    <TextBlock Text="Select some service"
                                               FontSize="23"
                                               Foreground="#202020"
                                               Margin="0,-5,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <Border Grid.Column="2"
                                Width="560"
                                Height="105"
                                HorizontalAlignment="Right"
                                Background="#83B8DE"
                                CornerRadius="28">

                            <TextBlock x:Name="CategoryNameText"
                                       Text="CATEGORY"
                                       FontSize="54"
                                       FontWeight="ExtraBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="510"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="510"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="510"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ServiceCard1"
                                Grid.Column="0"
                                Tag="0"
                                Style="{StaticResource ServiceCardStyle}"
                                Click="ServiceCard_Click">

                            <Grid Margin="20">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="95"/>
                                    <RowDefinition Height="145"/>
                                    <RowDefinition Height="65"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">

                                    <TextBlock x:Name="Service1Name"
                                               Text="Premium Bath"
                                               FontSize="37"
                                               FontWeight="ExtraBold"
                                               Foreground="#111111"
                                               VerticalAlignment="Center"/>

                                    <Grid Width="70"
                                          Height="70"
                                          HorizontalAlignment="Right">

                                        <Ellipse Fill="#E5E5E5"/>

                                        <Ellipse x:Name="Radio1"
                                                 Width="36"
                                                 Height="36"
                                                 Fill="Transparent"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                                    </Grid>

                                </Grid>

                                <Border Grid.Row="1"
                                        Background="#A8C9E8"
                                        CornerRadius="25"
                                        Padding="20,12">

                                    <TextBlock x:Name="Service1Description"
                                               Text="Deep clean + conditioner"
                                               FontSize="27"
                                               Foreground="#222222"
                                               TextWrapping="Wrap"/>

                                </Border>

                                <Border Grid.Row="2"
                                        Height="55"
                                        Background="#A8C9E8"
                                        CornerRadius="25"
                                        VerticalAlignment="Bottom">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="&#xE823;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="34"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#111111"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="Duration"
                                                   FontSize="27"
                                                   VerticalAlignment="Center"
                                                   Foreground="#111111"/>

                                        <TextBlock x:Name="Service1Duration"
                                                   Grid.Column="2"
                                                   Text="90 mins"
                                                   FontSize="25"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>

                                    </Grid>

                                </Border>

                            </Grid>

                        </Button>

                        <Button x:Name="ServiceCard2"
                                Grid.Column="2"
                                Tag="1"
                                Style="{StaticResource ServiceCardStyle}"
                                Click="ServiceCard_Click">

                            <Grid Margin="20">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="95"/>
                                    <RowDefinition Height="145"/>
                                    <RowDefinition Height="65"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">

                                    <TextBlock x:Name="Service2Name"
                                               Text="Basic Bath"
                                               FontSize="37"
                                               FontWeight="ExtraBold"
                                               Foreground="#111111"
                                               VerticalAlignment="Center"/>

                                    <Grid Width="70"
                                          Height="70"
                                          HorizontalAlignment="Right">

                                        <Ellipse Fill="#E5E5E5"/>

                                        <Ellipse x:Name="Radio2"
                                                 Width="36"
                                                 Height="36"
                                                 Fill="Transparent"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                                    </Grid>

                                </Grid>

                                <Border Grid.Row="1"
                                        Background="#A8C9E8"
                                        CornerRadius="25"
                                        Padding="20,12">

                                    <TextBlock x:Name="Service2Description"
                                               Text="Quick clean + dry"
                                               FontSize="27"
                                               Foreground="#222222"
                                               TextWrapping="Wrap"/>

                                </Border>

                                <Border Grid.Row="2"
                                        Height="55"
                                        Background="#A8C9E8"
                                        CornerRadius="25"
                                        VerticalAlignment="Bottom">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="&#xE823;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="34"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#111111"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="Duration"
                                                   FontSize="27"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock x:Name="Service2Duration"
                                                   Grid.Column="2"
                                                   Text="60 mins"
                                                   FontSize="25"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>

                                    </Grid>

                                </Border>

                            </Grid>

                        </Button>

                        <Button x:Name="ServiceCard3"
                                Grid.Column="4"
                                Tag="2"
                                Style="{StaticResource ServiceCardStyle}"
                                Click="ServiceCard_Click">

                            <Grid Margin="20">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="95"/>
                                    <RowDefinition Height="145"/>
                                    <RowDefinition Height="65"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">

                                    <TextBlock x:Name="Service3Name"
                                               Text="Bath+Dry Combo"
                                               FontSize="35"
                                               FontWeight="ExtraBold"
                                               Foreground="#111111"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>

                                    <Grid Width="70"
                                          Height="70"
                                          HorizontalAlignment="Right">

                                        <Ellipse Fill="#E5E5E5"/>

                                        <Ellipse x:Name="Radio3"
                                                 Width="36"
                                                 Height="36"
                                                 Fill="Transparent"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                                    </Grid>

                                </Grid>

                                <Border Grid.Row="1"
                                        Background="#A8C9E8"
                                        CornerRadius="25"
                                        Padding="20,12">

                                    <TextBlock x:Name="Service3Description"
                                               Text="Clean + dry + deodorizing"
                                               FontSize="27"
                                               Foreground="#222222"
                                               TextWrapping="Wrap"/>

                                </Border>

                                <Border Grid.Row="2"
                                        Height="55"
                                        Background="#A8C9E8"
                                        CornerRadius="25"
                                        VerticalAlignment="Bottom">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="&#xE823;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="34"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#111111"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="Duration"
                                                   FontSize="27"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock x:Name="Service3Duration"
                                                   Grid.Column="2"
                                                   Text="80 mins"
                                                   FontSize="25"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>

                                    </Grid>

                                </Border>

                            </Grid>

                        </Button>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Viewbox>

</UserControl>