<UserControl x:Class="Animal_Spa.Components.Receptionist.ServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Baloo2}">

    <UserControl.Resources>
        <Style x:Key="ServiceCardStyle" TargetType="Button">
            <Setter Property="Width" Value="550"/>
            <Setter Property="Height" Value="375"/>
            <Setter Property="Background" Value="#83B8DE"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="28">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.94"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.84"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1770" Height="640">
            <Border Width="1770"
                    Height="610"
                    Background="#A8C9E8"
                    CornerRadius="35"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="620"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="620"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="580"
                                Height="95"
                                HorizontalAlignment="Left"
                                Background="#83B8DE"
                                CornerRadius="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="/Animal-Spa;component/Asset/ICON-PET.png"
                                       Width="70"
                                       Height="70"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="SERVICE LIST"
                                               FontSize="36"
                                               FontWeight="ExtraBold"
                                               Foreground="#111111"/>
                                    <TextBlock Text="Select some service"
                                               FontSize="22"
                                               Foreground="#202020"
                                               Margin="0,-5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Width="560"
                                Height="95"
                                HorizontalAlignment="Right"
                                Background="#83B8DE"
                                CornerRadius="28">
                            <TextBlock x:Name="CategoryNameText"
                                       Text="CATEGORY"
                                       FontSize="50"
                                       FontWeight="ExtraBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="550"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="550"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="550"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ServiceCard1"
                                Grid.Column="0"
                                Tag="0"
                                Style="{StaticResource ServiceCardStyle}"
                                VerticalAlignment="Top"
                                Click="ServiceCard_Click">
                            <Grid Margin="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="80"/>
                                    <RowDefinition Height="170"/>
                                    <RowDefinition Height="65"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock x:Name="Service1Name"
                                               Text="Premium Bath"
                                               FontSize="35"
                                               FontWeight="ExtraBold"
                                               Foreground="#111111"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,0,80,0"/>
                                    <Grid Width="66" Height="66" HorizontalAlignment="Right">
                                        <Ellipse Fill="#E5E5E5"/>
                                        <Ellipse x:Name="Radio1"
                                                 Width="34"
                                                 Height="34"
                                                 Fill="Transparent"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>

                                <Border Grid.Row="1"
                                        Background="#A8C9E8"
                                        CornerRadius="24"
                                        Padding="20,16">
                                    <TextBlock x:Name="Service1Description"
                                               Text="Deep clean + conditioner"
                                               FontSize="25"
                                               Foreground="#222222"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Border Grid.Row="2"
                                        Height="56"
                                        Background="#A8C9E8"
                                        CornerRadius="24"
                                        Margin="0,9,0,0"
                                        VerticalAlignment="Top">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="145"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Animal-Spa;component/Asset/ICON-TIME.jpg"
                                               Width="36"
                                               Height="36"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="Duration"
                                                   FontSize="25"
                                                   VerticalAlignment="Center"
                                                   Foreground="#111111"/>
                                        <TextBlock x:Name="Service1Duration"
                                                   Grid.Column="2"
                                                   Text="90 mins"
                                                   FontSize="24"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="ServiceCard2"
                                Grid.Column="2"
                                Tag="1"
                                Style="{StaticResource ServiceCardStyle}"
                                VerticalAlignment="Top"
                                Click="ServiceCard_Click">
                            <Grid Margin="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="80"/>
                                    <RowDefinition Height="170"/>
                                    <RowDefinition Height="65"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock x:Name="Service2Name"
                                               Text="Basic Bath"
                                               FontSize="35"
                                               FontWeight="ExtraBold"
                                               Foreground="#111111"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,0,80,0"/>
                                    <Grid Width="66" Height="66" HorizontalAlignment="Right">
                                        <Ellipse Fill="#E5E5E5"/>
                                        <Ellipse x:Name="Radio2"
                                                 Width="34"
                                                 Height="34"
                                                 Fill="Transparent"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>

                                <Border Grid.Row="1"
                                        Background="#A8C9E8"
                                        CornerRadius="24"
                                        Padding="20,16">
                                    <TextBlock x:Name="Service2Description"
                                               Text="Quick clean + dry"
                                               FontSize="25"
                                               Foreground="#222222"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Border Grid.Row="2"
                                        Height="56"
                                        Background="#A8C9E8"
                                        CornerRadius="24"
                                        Margin="0,9,0,0"
                                        VerticalAlignment="Top">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="145"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Animal-Spa;component/Asset/ICON-TIME.jpg"
                                               Width="36"
                                               Height="36"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="Duration"
                                                   FontSize="25"
                                                   VerticalAlignment="Center"
                                                   Foreground="#111111"/>
                                        <TextBlock x:Name="Service2Duration"
                                                   Grid.Column="2"
                                                   Text="60 mins"
                                                   FontSize="24"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="ServiceCard3"
                                Grid.Column="4"
                                Tag="2"
                                Style="{StaticResource ServiceCardStyle}"
                                VerticalAlignment="Top"
                                Click="ServiceCard_Click">
                            <Grid Margin="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="80"/>
                                    <RowDefinition Height="170"/>
                                    <RowDefinition Height="65"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock x:Name="Service3Name"
                                               Text="Bath + Dry Combo"
                                               FontSize="33"
                                               FontWeight="ExtraBold"
                                               Foreground="#111111"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,0,80,0"/>
                                    <Grid Width="66" Height="66" HorizontalAlignment="Right">
                                        <Ellipse Fill="#E5E5E5"/>
                                        <Ellipse x:Name="Radio3"
                                                 Width="34"
                                                 Height="34"
                                                 Fill="Transparent"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>

                                <Border Grid.Row="1"
                                        Background="#A8C9E8"
                                        CornerRadius="24"
                                        Padding="20,16">
                                    <TextBlock x:Name="Service3Description"
                                               Text="Clean + dry + deodorizing"
                                               FontSize="25"
                                               Foreground="#222222"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Border Grid.Row="2"
                                        Height="56"
                                        Background="#A8C9E8"
                                        CornerRadius="24"
                                        Margin="0,9,0,0"
                                        VerticalAlignment="Top">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="145"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Animal-Spa;component/Asset/ICON-TIME.jpg"
                                               Width="36"
                                               Height="36"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="Duration"
                                                   FontSize="25"
                                                   VerticalAlignment="Center"
                                                   Foreground="#111111"/>
                                        <TextBlock x:Name="Service3Duration"
                                                   Grid.Column="2"
                                                   Text="80 mins"
                                                   FontSize="24"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
