<UserControl x:Class="Animal_Spa.Components.Receptionist.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1400"
             d:DesignHeight="760"
             FontFamily="{StaticResource Baloo2}"
             Background="White">

    <UserControl.Resources>
        <Style x:Key="BookingButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="62"/>
            <Setter Property="MinWidth" Value="230"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CustomerOptionTemplate">
            <Grid Height="64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="66"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="52"
                        Height="52"
                        Background="#EEF6FC"
                        CornerRadius="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Image Source="/Animal-Spa;component/Asset/ICON-COSTUMER.png"
                           Width="45"
                           Height="45"
                           Stretch="Uniform"/>
                </Border>

                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           FontSize="27"
                           FontWeight="ExtraBold"
                           Foreground="#161616"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="CustomerComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="82"/>
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="#161616"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9ECF8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="ItemTemplate" Value="{StaticResource CustomerOptionTemplate}"/>
            <Setter Property="MaxDropDownHeight" Value="270"/>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1770" Height="980">
            <Border Width="1630"
                    Height="900"
                    Background="#EEF6FC"
                    BorderBrush="#A8C9E8"
                    BorderThickness="2"
                    CornerRadius="38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="190"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="105"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#A8C9E8"
                            CornerRadius="38,38,0,0">
                        <Grid Margin="34,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="230"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="/Animal-Spa;component/Asset/ICON-PET.png"
                                   Width="82"
                                   Height="82"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="BOOKING"
                                           FontSize="40"
                                           FontWeight="ExtraBold"
                                           Foreground="#111111"/>
                                <TextBlock Text="Create and review customer booking"
                                           FontSize="22"
                                           Foreground="#202020"
                                           Margin="0,-4,0,0"/>
                            </StackPanel>

                            <Grid Grid.Column="2"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Margin="0,16,6,0">
                                <Ellipse Width="28" Height="28" Fill="#4A8DD8" HorizontalAlignment="Right" Margin="0,0,48,0"/>
                                <Ellipse Width="18" Height="18" Fill="#4A8DD8" HorizontalAlignment="Right" Margin="0,34,12,0"/>
                                <Ellipse Width="14" Height="14" Fill="#4A8DD8" HorizontalAlignment="Right" Margin="0,6,2,0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="34,24,34,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="820"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#A8C9E8"
                                CornerRadius="26"
                                Padding="24,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Customer"
                                           FontSize="30"
                                           FontWeight="ExtraBold"
                                           VerticalAlignment="Center"/>

                                <Border Grid.Row="1"
                                        Background="White"
                                        BorderBrush="#D9ECF8"
                                        BorderThickness="2"
                                        CornerRadius="22"
                                        Padding="4,0">
                                    <ComboBox x:Name="CustomerComboBox"
                                              Style="{StaticResource CustomerComboStyle}"
                                              SelectedValuePath="Id"
                                              SelectionChanged="CustomerComboBox_SelectionChanged"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="34,0,34,0"
                            Background="#DCEEF9"
                            CornerRadius="28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="112"/>
                                <RowDefinition Height="230"/>
                                <RowDefinition Height="82"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#A8C9E8"
                                    CornerRadius="28,28,0,0">
                                <Grid Margin="20,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Source="/Animal-Spa;component/Asset/ICON-PET.png"
                                           Width="68"
                                           Height="68"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="BOOKING DETAIL"
                                                   FontSize="34"
                                                   FontWeight="ExtraBold"/>
                                        <TextBlock Text="Service added to this booking"
                                                   FontSize="21"
                                                   Margin="0,-4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="10,12,10,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PanningMode="VerticalOnly">
                                    <ItemsControl x:Name="BookingItemsControl"
                                                  ItemsSource="{Binding BookingItems}"
                                                  HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="96"
                                                        Margin="0,0,0,10"
                                                        Background="#C6E1F5"
                                                        CornerRadius="22"
                                                        HorizontalAlignment="Stretch">
                                                    <Grid Margin="14,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="280"/>
                                                            <ColumnDefinition Width="290"/>
                                                            <ColumnDefinition Width="78"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="76"
                                                                Height="76"
                                                                Background="White"
                                                                CornerRadius="18"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                            <Image Source="{Binding ServiceIcon}"
                                                                   Width="68"
                                                                   Height="68"
                                                                   Stretch="UniformToFill"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Margin="10,0,14,0">
                                                            <TextBlock Text="{Binding ServiceName}"
                                                                       FontSize="29"
                                                                       FontWeight="ExtraBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding AnimalSummary}"
                                                                       FontSize="21"
                                                                       Foreground="#262626"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                        <Border Grid.Column="2"
                                                                Height="60"
                                                                Background="White"
                                                                CornerRadius="22"
                                                                Margin="8,0"
                                                                VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                <Image Source="/Animal-Spa;component/Asset/ICON-TIME.jpg"
                                                                       Width="36"
                                                                       Height="36"
                                                                       Stretch="Uniform"
                                                                       Margin="0,0,10,0"/>
                                                                <TextBlock Text="{Binding Duration}"
                                                                           FontSize="23"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Grid.Column="3"
                                                                Height="60"
                                                                Background="#A8CFF0"
                                                                CornerRadius="22"
                                                                Margin="8,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PriceText}"
                                                                       FontSize="26"
                                                                       FontWeight="ExtraBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>

                                                        <Button Grid.Column="4"
                                                                Width="58"
                                                                Height="58"
                                                                Background="White"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Tag="{Binding}"
                                                                Click="RemoveService_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="14">
                                                                        <TextBlock Text="&#xE74D;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="31"
                                                                                   Foreground="#111111"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock x:Name="EmptyBookingText"
                                           Text="No service selected yet"
                                           FontSize="24"
                                           Foreground="#667788"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="24,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TotalServicesText"
                                           Text="Total services: 0"
                                           FontSize="27"
                                           FontWeight="ExtraBold"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Total:"
                                               FontSize="27"
                                               FontWeight="ExtraBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,18,0"/>
                                    <Border Background="#4EA6E8"
                                            CornerRadius="16"
                                            Padding="24,8">
                                        <TextBlock x:Name="TotalPriceText"
                                                   Text="0đ"
                                                   FontSize="30"
                                                   FontWeight="ExtraBold"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,34,0">
                        <Button Content="Cancel"
                                Background="#D2D5D8"
                                Style="{StaticResource BookingButtonStyle}"
                                Margin="0,0,20,0"
                                Click="Cancel_Click"/>
                        <Button Content="Save Booking"
                                Background="#4EA6E8"
                                Style="{StaticResource BookingButtonStyle}"
                                Click="SaveBooking_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
