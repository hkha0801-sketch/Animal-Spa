<UserControl x:Class="Animal_Spa.Components.Shared.PhotoUpload"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root"
 Background="Transparent" Cursor="Hand">
 <Grid MouseLeftButtonUp="ChoosePhoto">
  <Rectangle x:Name="UploadRectangle" RadiusX="39" RadiusY="39"
   Fill="{Binding PhotoFill, ElementName=Root}"
   Stroke="{Binding BorderBrush, ElementName=Root}"
   StrokeDashArray="{Binding StrokeDashArray, ElementName=Root}" StrokeThickness="3"/>
  <ContentPresenter x:Name="FallbackPresenter" Content="{Binding FallbackContent, ElementName=Root}"
   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
 </Grid>
</UserControl>
