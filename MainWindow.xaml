<Window x:Class="Animal_Spa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API Connection Test"
        Width="500"
        Height="300"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="40">

        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="WPF → API Connection"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="http://localhost:5052/"
                       Margin="0,15,0,20"
                       Foreground="Gray"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="StatusText"
                       Text="Not checked"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <Button Content="Check API"
                    Width="160"
                    Height="40"
                    Click="CheckApi_Click"
                    HorizontalAlignment="Center"/>

        </StackPanel>

    </Grid>
</Window>