<UserControl x:Class="Animal_Spa.Views.Customer.CustomerDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Animal_Spa.Components.Receptionist"
             mc:Ignorable="d"
             d:DesignWidth="1400"
             d:DesignHeight="900"
             Background="White">

    <UserControl.Resources>
        <Style x:Key="SectionDividerStyle" TargetType="Border">
            <Setter Property="Width" Value="260"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#83B7DF"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8,0,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="DashboardScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="White">
        <StackPanel Background="White">

            <components:CustomerDetailView x:Name="CustomerDetail"
                                           Margin="30,30,30,0"/>

            <Border Style="{StaticResource SectionDividerStyle}"
                    Visibility="{Binding ElementName=AddPet, Path=Visibility}"/>

            <components:AddPetView x:Name="AddPet"
                                   Visibility="Collapsed"
                                   Margin="30,0,30,0"/>

            <Border Style="{StaticResource SectionDividerStyle}"/>

            <components:CategoryView x:Name="Category"
                                     Margin="30,0,30,0"
                                     HorizontalAlignment="Stretch"/>

            <Border Style="{StaticResource SectionDividerStyle}"/>

            <components:ServiceView x:Name="Service"
                                    Visibility="Collapsed"
                                    Margin="30,0,30,0"
                                    HorizontalAlignment="Stretch"/>

            <Border Style="{StaticResource SectionDividerStyle}"
                    Visibility="{Binding ElementName=ServiceDetail, Path=Visibility}"/>

            <components:ServiceDetailView x:Name="ServiceDetail"
                                          Visibility="Collapsed"
                                          Margin="30,0,30,20"
                                          HorizontalAlignment="Stretch"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
