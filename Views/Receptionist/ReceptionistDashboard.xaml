<UserControl x:Class="Animal_Spa.Views.Receptionist.ReceptionistDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Animal_Spa.Components.Receptionist"
             Background="White">

    <UserControl.Resources>
        <Style x:Key="SectionDividerStyle" TargetType="Border">
            <Setter Property="Width" Value="350"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="#83B7DF"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,20,0,35"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="DashboardScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="White">
        <StackPanel Background="White">

            <components:CustomerListView x:Name="CustomerList"
                                         Margin="30,30,30,0"/>

            <Border Style="{StaticResource SectionDividerStyle}"
                    Visibility="{Binding ElementName=CustomerDetail, Path=Visibility}"/>

            <components:CustomerDetailView x:Name="CustomerDetail"
                                           Visibility="Collapsed"
                                           Margin="30,0,30,0"/>

            <Border Style="{StaticResource SectionDividerStyle}"
                    Visibility="{Binding ElementName=AddCustomer, Path=Visibility}"/>

            <components:AddCustomerView x:Name="AddCustomer"
                                        Visibility="Collapsed"
                                        Margin="30,0,30,0"/>

            <Border Style="{StaticResource SectionDividerStyle}"
                    Visibility="{Binding ElementName=AddPet, Path=Visibility}"/>

            <components:AddPetView x:Name="AddPet"
                                   Visibility="Collapsed"
                                   Margin="30,0,30,0"/>

            <Border Style="{StaticResource SectionDividerStyle}"/>

            <components:CategoryView x:Name="Category"
                                     Margin="30,0,30,0"/>

            <Border Style="{StaticResource SectionDividerStyle}"/>

            <components:ServiceView x:Name="Service"
                                    Visibility="Collapsed"
                                    Margin="30,0,30,0"/>

            <Border Style="{StaticResource SectionDividerStyle}"
                    Visibility="{Binding ElementName=ServiceDetail, Path=Visibility}"/>

            <components:ServiceDetailView x:Name="ServiceDetail"
                                          Visibility="Collapsed"
                                          Margin="30,0,30,45"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
