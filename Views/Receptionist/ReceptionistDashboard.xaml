<UserControl x:Class="Animal_Spa.Views.Receptionist.ReceptionistDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Animal_Spa.Components.Receptionist"
             Background="#F7FBFE">

    <ScrollViewer x:Name="DashboardScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <components:CustomerListView x:Name="CustomerList"
                                         Margin="30,30,30,30"/>

            <components:CustomerDetailView x:Name="CustomerDetail"
                                           Visibility="Collapsed"
                                           Margin="30,0,30,40"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
