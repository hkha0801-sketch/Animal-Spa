<UserControl x:Class="Animal_Spa.Views.Receptionist.ReceptionistDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Animal_Spa.Components.Receptionist"
             Background="#F7FBFE">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <components:CustomerListView Margin="30,30,30,30"/>

            <!-- Các component tiếp theo sẽ thêm phía dưới:
                 Customer Detail
                 Add Customer
                 Pet Information
                 Booking / Service ... -->
        </StackPanel>
    </ScrollViewer>
</UserControl>
