<Window x:Class="Animal_Spa.LoginViews"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Animal Spa - Login"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    
    <Viewbox Stretch="Uniform">

        <Grid Width="1920"
              Height="1080">

            
            <Image Source="/Animal-Spa;component/Asset/BACKGROUND-LOGIN.jpg"
                   Stretch="Fill"
                   Panel.ZIndex="0"/>

            <Border Width="706"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="1204,0,0,0"
                    Background="Transparent"
                    Panel.ZIndex="1">

                <StackPanel>
                    
                    <Border Width="270"
                            Height="55"
                            Background="#E1E1E1"
                            CornerRadius="28"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>


                            <Button x:Name="UserButton"
                                    Grid.Column="0"
                                    Content="USER"
                                    Click="UserButton_Click"
                                    FontFamily="Baloo 2"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Background="#83B8E4"
                                    BorderThickness="0"
                                    Cursor="Hand">

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="28">

                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>

                                </Button.Template>

                            </Button>

                            <Button x:Name="StaffButton"
                                    Grid.Column="1"
                                    Content="STAFF"
                                    Click="StaffButton_Click"
                                    FontFamily="Baloo 2"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="28">

                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>

                                </Button.Template>

                            </Button>

                        </Grid>

                    </Border>

                    <TextBlock x:Name="LoginTitle"
                               Text="USER LOGIN"
                               FontFamily="Baloo 2"
                               FontSize="68"
                               FontWeight="ExtraBold"
                               Foreground="#82B8E5"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,34"/>

                    <TextBlock Text="Username"
                               FontFamily="Baloo 2"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#222222"
                               Margin="0,0,0,7"/>

                    <Border Height="58"
                            Background="#F3F3F3"
                            CornerRadius="8"
                            Margin="0,0,0,18">

                        <TextBox x:Name="UsernameTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="16,0"
                                 FontFamily="Baloo 2"
                                 FontSize="26"
                                 VerticalContentAlignment="Center"/>

                    </Border>

                    <TextBlock Text="Password"
                               FontFamily="Baloo 2"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#222222"
                               Margin="0,0,0,7"/>

                    <Border Height="58"
                            Background="#F3F3F3"
                            CornerRadius="8">

                        <Grid>

                            <PasswordBox x:Name="PasswordInput"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="16,0,55,0"
                                         FontFamily="Baloo 2"
                                         FontSize="26"
                                         VerticalContentAlignment="Center"
                                         Visibility="Visible"/>

                            <TextBox x:Name="PasswordVisibleInput"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,0,55,0"
                                     FontFamily="Baloo 2"
                                     FontSize="26"
                                     VerticalContentAlignment="Center"
                                     Visibility="Collapsed"/>


                            <Button x:Name="ShowPasswordButton"
                                    Width="45"
                                    Height="45"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Show password"
                                    Click="ShowPasswordButton_Click">

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border Background="Transparent">

                                            <TextBlock x:Name="EyeIcon"
                                                       Text="&#xE890;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="20"
                                                       Foreground="#9A9A9A"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver"
                                                     Value="True">

                                                <Setter TargetName="EyeIcon"
                                                        Property="Foreground"
                                                        Value="#4DA5E5"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Button.Template>

                            </Button>

                        </Grid>

                    </Border>

                    <Button x:Name="LoginButton"
                            Content="Login"
                            Height="48"
                            Click="LoginButton_Click"
                            FontFamily="Baloo 2"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="White"
                            Background="#4DA5E5"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,20,0,0">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border x:Name="LoginBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="7">

                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver"
                                             Value="True">

                                        <Setter TargetName="LoginBorder"
                                                Property="Background"
                                                Value="#378FD0"/>

                                    </Trigger>

                                    <Trigger Property="IsPressed"
                                             Value="True">

                                        <Setter TargetName="LoginBorder"
                                                Property="Opacity"
                                                Value="0.8"/>

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    <TextBlock x:Name="ErrorText"
                               Text=""
                               FontFamily="Baloo 2"
                               FontSize="25"
                               Foreground="#E65B5B"
                               TextAlignment="Center"
                               Margin="0,12,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

    </Viewbox>

</Window>