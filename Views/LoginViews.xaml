<Window x:Class="Animal_Spa.LoginViews"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Animal_Spa"
        mc:Ignorable="d"
        Title="Login" Height="1920" Width="1080">
    <Grid Width="1920" Height="1080">
        <Image Source="Asset/BACKGROUND-REGISTER-LEFT.jpg"
               Stretch="Fill"
               Panel.Zindex="0"/>
        
        <Image Source="Asset/BACKGROUND-REGISTER-RIGHT.jpg"
               Stretch="Fill"
               Panel.Zindex="1"/>

        <Border Width="400" 
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Transparent"
                Panel.Zindex="2">

                <Stack Panel>
                    <TextBlock Text="USERLOGIN"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Username"
                               HorizontalAlignment="Left"/>
                    <TextBox>
                    <TextBlock Text="Password"
                               HorizontalAlignment="Left"/>
                    <PasswordBox>
                    <Button Content="LOGIN">
                    <TextBlock Text="Forget your pasword?"
                               HorizontalAlignment="Left"/>
                </Stack Panel>
        </Border>

    </Grid>

</Window>